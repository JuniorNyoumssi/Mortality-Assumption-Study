### Age specific credibility weighting using GLM_qx as Prior

calculate_age_specific_credibility <- function(
    data,
    model,
    group_variable = "AgeBand",
    confidence = 0.95,
    relative_error = 0.05
) {
  
  z_critical <- qnorm(1 - (1 - confidence) / 2)
  
  # Predict expected deaths at the individual record level
  data_with_predictions <- data %>%
    mutate(
      ExpectedDeaths = predict(
        model,
        newdata = data,
        type = "response"
      )
    )
  
  results <- data_with_predictions %>%
    group_by(Group = .data[[group_variable]]) %>%
    summarise(
      Policies = n(),
      ActualDeaths = sum(Death, na.rm = TRUE),
      ExpectedDeaths = sum(ExpectedDeaths, na.rm = TRUE),
      Exposure = sum(Exposure, na.rm = TRUE),
      .groups = "drop"
    ) %>%
    mutate(
      q_experience = ActualDeaths / Exposure,
      q_GLM = ExpectedDeaths / Exposure,
      
      # Age-specific full-credibility exposure
      FullCredibilityExposure =
        z_critical^2 / (relative_error^2 * q_GLM),
      
      # Exposure-based credibility
      Z = pmin(
        1,
        sqrt(Exposure / FullCredibilityExposure)
      ),
      
      # Credibility-weighted mortality
      q_credible =
        Z * q_experience + (1 - Z) * q_GLM
    ) %>%
    arrange(Group)
  
  return(results)
}



