### We'll calculate the relative mortality at durations 1 and 2 compared with duration 3.

select_factors <- duration_rates %>%
  select(AgeBand, Duration, q_duration) %>%
  tidyr::pivot_wider(
    names_from = Duration,
    values_from = q_duration,
    names_prefix = "Duration_"
  ) %>%
  mutate(
    SelectFactor_1 = Duration_1 / Duration_3,
    SelectFactor_2 = Duration_2 / Duration_3,
    UltimateFactor = 1
  )

print(select_factors)




### Build the candidate select-and-ultimate table
### We'll combine these factors with our existing credibility-weighted 2026 rates. 
### This retains our selected mortality level while using the GLM to estimate the relative 
### duration pattern.


select_ultimate_table <- mortality_credibility_2026 %>%
  select(AgeBand, q_2026) %>%
  left_join(
    select_factors %>%
      select(
        AgeBand,
        SelectFactor_1,
        SelectFactor_2
      ),
    by = "AgeBand"
  ) %>%
  mutate(
    q_duration_1 = q_2026 * SelectFactor_1,
    q_duration_2 = q_2026 * SelectFactor_2,
    q_duration_3_plus = q_2026
  )

print(select_ultimate_table)












































