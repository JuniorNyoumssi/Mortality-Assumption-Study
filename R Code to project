### Confidence interval function to decide whether the decile deviations 
### warrant further investigation or whether we are ready to proceed to credibility.


add_ae_confidence_intervals <- function(ae_data, confidence = 0.95) {
  
  alpha <- 1 - confidence
  
  ae_data %>%
    mutate(
      AE_Lower = if_else(
        ActualDeaths == 0,
        0,
        qchisq(
          alpha / 2,
          df = 2 * ActualDeaths
        ) / (2 * ExpectedDeaths)
      ),
      AE_Upper = qchisq(
        1 - alpha / 2,
        df = 2 * (ActualDeaths + 1)
      ) / (2 * ExpectedDeaths),
      AE_Flag = case_when(
        AE_Lower > 1 ~ "Underprediction",
        AE_Upper < 1 ~ "Overprediction",
        TRUE ~ "No clear evidence of miscalibration"
      )
    )
}

