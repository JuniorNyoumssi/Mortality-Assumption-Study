calculate_mortality_deciles <- function(data, model) {
  
  data %>%
    mutate(
      ExpectedDeaths = predict(
        model,
        newdata = data,
        type = "response"
      ),
      PredictedRate = ExpectedDeaths / Exposure
    ) %>%
    mutate(
      Decile = ntile(PredictedRate, 10)
    ) %>%
    group_by(Decile) %>%
    summarise(
      Policies = n(),
      ActualDeaths = sum(Death),
      ExpectedDeaths = sum(ExpectedDeaths),
      Exposure = sum(Exposure),
      AE_Ratio = ActualDeaths / ExpectedDeaths,
      ObservedRate = ActualDeaths / Exposure,
      ExpectedRate = ExpectedDeaths / Exposure,
      .groups = "drop"
    ) %>%
    arrange(Decile)
}

