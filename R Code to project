calculate_two_way_ae <- function(data, model,
                                 group_variable_1,
                                 group_variable_2) {
  
  data %>%
    mutate(
      ExpectedDeaths = predict(
        model,
        newdata = data,
        type = "response"
      ),
      Group1 = as.character(.data[[group_variable_1]]),
      Group2 = as.character(.data[[group_variable_2]])
    ) %>%
    group_by(Group1, Group2) %>%
    summarise(
      Policies = n(),
      ActualDeaths = sum(Death),
      ExpectedDeaths = sum(ExpectedDeaths),
      Exposure = sum(Exposure),
      AE_Ratio = if_else(
        ExpectedDeaths > 0,
        ActualDeaths / ExpectedDeaths,
        NA_real_
      ),
      ObservedRate = if_else(
        Exposure > 0,
        ActualDeaths / Exposure,
        NA_real_
      ),
      ExpectedRate = if_else(
        Exposure > 0,
        ExpectedDeaths / Exposure,
        NA_real_
      ),
      .groups = "drop"
    )
}


