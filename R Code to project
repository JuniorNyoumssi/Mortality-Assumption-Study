### Credibility weighting with q prior as overall portfolio qx


library(dplyr)

calculate_mortality_credibility <- function(
    data,
    group_variable = "AgeBand",
    confidence = 0.95,
    relative_error = 0.05
) {
  
  # Overall portfolio mortality rate: our prior
  total_exposure <- sum(data$Exposure, na.rm = TRUE)
  total_deaths <- sum(data$Death, na.rm = TRUE)
  
  q_prior <- total_deaths / total_exposure
  
  # Exposure required for full credibility
  z_critical <- qnorm(1 - (1 - confidence) / 2)
  
  full_credibility_exposure <-
    z_critical^2 / (relative_error^2 * q_prior)
  
  # Group-level experience and credibility
  results <- data %>%
    group_by(Group = .data[[group_variable]]) %>%
    summarise(
      Policies = n(),
      ActualDeaths = sum(Death, na.rm = TRUE),
      Exposure = sum(Exposure, na.rm = TRUE),
      .groups = "drop"
    ) %>%
    mutate(
      q_experience = ActualDeaths / Exposure,
      q_prior = q_prior,
      
      Z = pmin(
        1,
        sqrt(Exposure / full_credibility_exposure)
      ),
      
      q_credible =
        Z * q_experience + (1 - Z) * q_prior
    ) %>%
    arrange(Group)
  
  return(results)
}




