library(dplyr)

# Predict mortality at the 2025 reference year for
# policy durations 1, 2, and 3.

predict_duration_rates <- function(
    data,
    model,
    durations = c(1, 2, 3)
) {
  
  bind_rows(lapply(durations, function(d) {
    
    prediction_data <- data %>%
      mutate(
        Duration = d,
        CalendarYearCentered = 0
      )
    
    prediction_data$ExpectedDeaths <- predict(
      model,
      newdata = prediction_data,
      type = "response"
    )
    
    prediction_data %>%
      group_by(AgeBand) %>%
      summarise(
        Exposure = sum(Exposure, na.rm = TRUE),
        ExpectedDeaths = sum(ExpectedDeaths, na.rm = TRUE),
        q_duration = ExpectedDeaths / Exposure,
        .groups = "drop"
      ) %>%
      mutate(Duration = d)
    
  }))
}

