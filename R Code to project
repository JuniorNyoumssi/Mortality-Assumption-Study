### Credibility with q prior as GLM qx



library(dplyr)

calculate_glm_based_credibility <- function(
    data,
    model,
    group_variable = "AgeBand",
    confidence = 0.95,
    relative_error = 0.05
) {
  
  # Portfolio-wide mortality rate used only to set
  # the initial full-credibility exposure threshold
  q_portfolio <- sum(data$Death, na.rm = TRUE) /
    sum(data$Exposure, na.rm = TRUE)
  
  z_critical <- qnorm(1 - (1 - confidence) / 2)
  
  full_credibility_exposure <-
    z_critical^2 /
    (relative_error^2 * q_portfolio)
  
  # Predict expected deaths at the individual record level
  data_with_predictions <- data %>%
    mutate(
      ExpectedDeaths = predict(
        model,
        newdata = data,
        type = "response"
      )
    )
  
  # Aggregate observed and expected experience by group
  results <- data_with_predictions %>%
    group_by(Group = .data[[group_variable]]) %>%
    summarise(
      Policies = n(),
      ActualDeaths = sum(Death, na.rm = TRUE),
      ExpectedDeaths = sum(ExpectedDeaths, na.rm = TRUE),
      Exposure = sum(Exposure, na.rm = TRUE),
      .groups = "drop"
    ) %>%
    mutate(
      q_experience = ActualDeaths / Exposure,
      q_GLM = ExpectedDeaths / Exposure,
      
      # Keep the same credibility rule for this comparison
      Z = pmin(
        1,
        sqrt(Exposure / full_credibility_exposure)
      ),
      
      q_credible =
        Z * q_experience + (1 - Z) * q_GLM,
      
      A_E_Ratio = ActualDeaths / ExpectedDeaths
    ) %>%
    arrange(Group)
  
  return(results)
}



