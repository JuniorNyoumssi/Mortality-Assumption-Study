apply_mortality_improvement <- function(
    mortality_table,
    base_year,
    target_year,
    improvement_rate = 0.01,
    rate_column = "q_credible"
) {
  years <- target_year - base_year
  
  if (years < 0) {
    stop("Target year must be greater than or equal to base year.")
  }
  
  if (improvement_rate < 0 || improvement_rate >= 1) {
    stop("Improvement rate must be between 0 and 1.")
  }
  
  mortality_table$BaseMortality <-
    mortality_table[[rate_column]]
  
  mortality_table$ProjectedMortality <-
    mortality_table$BaseMortality *
    (1 - improvement_rate)^years
  
  mortality_table$BaseYear <- base_year
  mortality_table$TargetYear <- target_year
  mortality_table$ImprovementRate <- improvement_rate
  
  mortality_table
}


